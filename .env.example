# 漫画工坊 — 敏感配置 (不要提交到 git)
# 本文件由 app.py 启动时自动加载 (python-dotenv)
# 缺省时 SECRET_KEY 与 ADMIN_PASSWORD 会自动随机生成并写回本文件

# Flask session 签名密钥 (重启后不会失效, 不要泄漏)
MANGA_SECRET_KEY=

# 管理员登录凭据 (首次启动随机生成, 请修改后再部署到公网)
MANGA_ADMIN_USERNAME=admin
MANGA_ADMIN_PASSWORD=

# LLM 最大输出 token
# 模型规格: 上下文 512k, 最大输出 128k
# 默认 32768 (32k) 平衡速度与稳定性; 想要长输出可调到 65536 / 131072
# 设太高会显著增加响应耗时, 设太低会被截断
MANGA_LLM_MAX_TOKENS=32768
